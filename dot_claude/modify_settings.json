#!/bin/sh

# Preserve unmanaged settings; Herdr owns the SessionStart hook. Sort output
# without a trailing newline to avoid formatting churn with Herdr.

# Never overwrite settings if jq is unavailable.
if ! command -v jq >/dev/null 2>&1; then
  cat
  exit 0
fi

# Match Herdr's newline-free output.
printf '%s' "$(jq -S -n --arg home "$HOME" '
  (input? // {})

  | .attribution = {commit: "", pr: ""}
  | .permissions.defaultMode = "auto"
  | .tui = "fullscreen"
  | .theme = "auto"

  | .statusLine = {
      type: "command",
      command: ("sh " + $home + "/.claude/statusline-command.sh")
    }
')"
