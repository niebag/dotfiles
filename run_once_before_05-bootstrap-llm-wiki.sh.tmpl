#!/bin/sh

set -eu

vault_root="$HOME/Obsidian/llm-wiki"
skeleton_root="{{ .chezmoi.sourceDir }}/private_Obsidian/llm-wiki"

mkdir -p "$vault_root/raw/assets" "$vault_root/raw/inbox" "$vault_root/raw/ingested" "$vault_root/wiki/sources"
[ -e "$vault_root/AGENTS.md" ] || cp "$skeleton_root/AGENTS.md" "$vault_root/AGENTS.md"
[ -e "$vault_root/log.md" ] || : > "$vault_root/log.md"
