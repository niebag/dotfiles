#!/bin/sh

set -eu

vault_root="$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents"
skeleton_root="{{ .chezmoi.sourceDir }}/private_Library/Mobile Documents/iCloud~md~obsidian/Documents"

for vault in Notive Personal Resolph; do
  target="$vault_root/$vault"
  mkdir -p "$target"
  rsync -r --exclude CLAUDE.md.tmpl --exclude log.md "$skeleton_root/$vault/" "$target/"
  chezmoi execute-template --file "$skeleton_root/$vault/CLAUDE.md.tmpl" > "$target/CLAUDE.md"
  [ -e "$target/log.md" ] || : > "$target/log.md"
done
