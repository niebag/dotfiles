#!/bin/sh

# Install packages before chezmoi writes its managed files.
# Read the source Brewfile directly instead of relying on ~/.Brewfile.

{{- if eq .chezmoi.os "darwin" }}
set -eu

command -v brew >/dev/null 2>&1 || { echo "brew not found; skipping packages" >&2; exit 0; }

brew bundle install --file=/dev/stdin <<'EOF'
{{ include "dot_Brewfile" }}
EOF
{{- end }}
